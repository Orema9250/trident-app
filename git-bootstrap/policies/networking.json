 {
 "Version" : "2012-10-17",
    "Statement" : [
      {
        "Sid" : "VpcPolicy",
        "Action" : [
          "ec2:AttachInternetGateway",
          "ec2:CreateRouteTable",
          "ec2:CreateSubnet",
          "ec2:CreateVpc",
          "ec2:CreateVpcEndpoint",
          "ec2:DeleteVpc",
          "ec2:DescribeVpcAttribute",
          "ec2:DetachInternetGateway",
          "ec2:GetSecurityGroupsForVpc",
          "ec2:ModifyVpcAttribute",
          "ec2:CreateSecurityGroup"
        ],
        "Effect"  : "Allow",
        "Resource" : "arn:aws:ec2:us-east-1:090243701151:vpc/*"
      },
      {
        "Sid" : "DescribeAccountAttributes",
        "Action" : [
          "ec2:DescribeAccountAttributes",
          "ec2:CreateTags",
          "ec2:DescribeVpcs",
          "ec2:DescribeInternetGateways",
          "ec2:DescribeAddresses",
          "ec2:DescribeAddressesAttribute",
          "ec2:DescribeNetworkInterfaces",
          "ec2:DescribeNatGateways",
          "ec2:DescribeRouteTables",
          "ec2:DescribeVpcEndpoints",
          "ec2:DescribePrefixLists",
          "ec2:DescribeSecurityGroups",
          "ec2:DescribeSubnets",
          "ec2:DescribeNetworkAcls",
          "ec2:DescribeAvailabilityZones",
          "ec2:DisassociateAddress",
          "ec2:DisassociateRouteTable",
          "ec2:ReleaseAddress"
        ],
        "Effect"  : "Allow",
        "Resource" : "*"
      },
      {
        "Sid" : "InternetGateway",
        "Action" : [
          "ec2:AttachInternetGateway",
          "ec2:CreateInternetGateway",
          "ec2:DeleteInternetGateway",
          "ec2:DetachInternetGateway"
        ],
        "Effect"   : "Allow",
        "Resource" : "arn:aws:ec2:us-east-1:090243701151:internet-gateway/*"
      },
      {
        "Sid" : "ElasticIpAddress",
        "Action" : [
          "ec2:AllocateAddress",
          "ec2:CreateNatGateway"
        ],
        "Effect"   : "Allow",
        "Resource" : "arn:aws:ec2:us-east-1:090243701151:elastic-ip/*"
      },
      {
        "Sid" : "NatGateways",
        "Action" : [
          "ec2:CreateNatGateway",
          "ec2:DeleteNatGateway"
        ],
        "Effect"   : "Allow",
        "Resource" : "arn:aws:ec2:us-east-1:090243701151:natgateway/*"
      },
      {
        "Sid" : "RouteTable",
        "Action" : [
          "ec2:CreateRoute",
          "ec2:CreateRouteTable",
          "ec2:AssociateRouteTable",
          "ec2:DeleteRouteTable",
          "ec2:CreateVpcEndpoint"
        ],
        "Effect"   : "Allow",
        "Resource" : "arn:aws:ec2:us-east-1:090243701151:route-table/*"
      },
      {
        "Sid" : "VpcEndpoints",
        "Action" : [
          "ec2:DeleteVpcEndpoints",
          "ec2:CreateVpcEndpoint"
        ],
        "Effect" : "Allow",
        "Resource" : "arn:aws:ec2:us-east-1:090243701151:vpc-endpoint/*"
      },
      {
        "Sid" : "SecurityGroups",
        "Action" : [
          "ec2:CreateSecurityGroup",
          "ec2:DeleteSecurityGroup",
          "ec2:AuthorizeSecurityGroupEgress",
          "ec2:AuthorizeSecurityGroupIngress",
          "ec2:RevokeSecurityGroupEgress"
        ],
        "Effect"   : "Allow" ,
        "Resource" : "arn:aws:ec2:us-east-1:090243701151:security-group/*"
      },
      {
        "Sid" : "Subnets" ,
        "Action" : [
          "ec2:DeleteSubnet",
          "ec2:CreateSubnet",
          "ec2:ModifySubnetAttribute",
          "ec2:AssociateRouteTable",
          "ec2:CreateNatGateway",
          "ec2:CreateVpcEndpoint"
        ],
        "Effect" : "Allow",
        "Resource" : "arn:aws:ec2:us-east-1:090243701151:subnet/*"
      }
    ]
 }    
    